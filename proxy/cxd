#!/usr/bin/env bash
# cxd —— **单号直连**的 codex 入口（用户 2026-09-09 定稿）。
#
# 直接调真二进制，**绕过 PATH wrapper**，所以既不注入 `--profile rotateproxy`、
# 也不经过轮换代理。用它跑 `/usage` 看重置卡才有意义 —— 那个命令问的是
# 「当前这一个号」的额度，而经过代理时每个请求都可能落在不同的号上。
#
# ★ 其余入口一律走代理（受 CodexBar 里「账号池 ↔ 中转站」那个开关控制）：
#     codex / \codex / omc ask codex / VS Code
#
# ⚠️ 这里**故意不带任何 profile**。加了就不是"直连"了，而它的整个存在理由就是直连。
set -euo pipefail

# ★★ **杀号守卫必须在这里再来一遍。**（2026-09-10 修，Fable 评审抓到）
#    `cxd` 直连真二进制、绕过 PATH wrapper —— 于是也绕过了 wrapper 里那道
#    「`codex logout` 会在服务端 revoke 当值号」的拦截。而 `cxd` 被定位成
#    **单号直连入口**，正是最可能被敲 `logout` 的地方：一条命令永久杀掉当前活跃号
#    （实测两次：2026-07-30 因此死了 plus3/plus4/plus7）。
#    ⚠️ 这不是"重复实现" —— 判据函数与 wrapper 共用同一份 `codex-profile-scope.sh`，
#    重复的只有调用点，而每个绕过 wrapper 的入口都必须有一个调用点。
# ★★ 判据文件按**自己在哪**找，不按数据目录猜（B85，2026-10-16 四方评审）。
#    原来默认 `~/Projects/tools/codex-account-rotator` —— 作者的 clone 路径。别人机器上它不存在
#    ⇒ 走下面的 else，只认 `$1` 是 logout/login，`cxd --foo logout` 这类就漏过去了。
_cxd_resolve() {
  local p="$1" d
  while [ -L "$p" ]; do
    d="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd)" || break
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="${d}/${p}" ;; esac
  done
  d="$(cd -P "$(dirname "$p")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$d" "$(basename "$p")"
}
_cxd_self="$(_cxd_resolve "${BASH_SOURCE[0]}" 2>/dev/null || true)"
_cxd_code="$(dirname "$(dirname "${_cxd_self:-/nonexistent/x/y}")")"     # <code>/proxy/cxd
if [ -z "${CODEX_ROTATE_STORE:-}" ]; then
  if [ "$(basename "$_cxd_code")" = "runtime" ]; then export CODEX_ROTATE_STORE="$(dirname "$_cxd_code")"
  else export CODEX_ROTATE_STORE="$_cxd_code"; fi
fi
_cxd_scope="${_cxd_code}/proxy/codex-profile-scope.sh"
if [ -f "$_cxd_scope" ]; then
  # shellcheck source=codex-profile-scope.sh
  . "$_cxd_scope"
  if codex_is_credential_command "$@"; then
    case " $* " in
      *" --force "*|*" --yes "*) ;;   # 与 wrapper 同一个逃生口
      *)
        printf '%s\n' \
          "⛔ cxd 已拦截 \`$(codex_subcommand "$@")\`" \
          "" \
          "logout 会把【当前活跃号】的 token 在 OpenAI 服务端 revoke（不是本地登出）；" \
          "login 会覆盖 ~/.codex/auth.json，把上一个号的最新 token 丢掉。" \
          "本仓的号只存在于那一份文件里，两者都等于永久杀号。" \
          "" \
          "要加号 / 重登，请改用：  codex-rotate login" \
          "" \
          "真的要 revoke（几乎不需要）：cxd logout --force" >&2
        exit 1 ;;
    esac
  fi
else
  # ⚠️ 判据文件不在 = 安装坏了。**凭证类命令一律不放行** —— 解析不出子命令
  #   就等于没有守卫，而它守的是"会杀号"。其余命令照常直连（cxd 的存在理由）。
  case "${1:-}" in
    logout|login)
      printf '%s\n' "⛔ cxd: 找不到判据文件 ${_cxd_scope} —— 拒绝执行会动凭证的命令。" >&2
      exit 78 ;;
  esac
fi

# ★★ 真二进制：PATH 上找，**跳过我们自己的 wrapper**（B85）。原来写死 `~/.local/npm-global/bin/codex`
#    （作者的 npm prefix）—— 别人机器上是 `No such file`。wrapper 可能是链接也可能是复制件，
#    所以按内容认：它是个 shell 脚本且引用了判据文件；官方 codex 不会。
_cxd_real_codex() {
  local d c
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    c="${d}/codex"
    [ -x "$c" ] && [ ! -d "$c" ] || continue
    if [ "$(head -c 2 "$c" 2>/dev/null)" = "#!" ] && [ "$(wc -c < "$c")" -lt 1048576 ] \
       && grep -q "codex-profile-scope.sh" "$c" 2>/dev/null; then
      continue
    fi
    printf '%s\n' "$c"
    return 0
  done <<< "$(printf '%s' "$PATH" | tr ':' '\n')"
  return 1
}
_cxd_bin="${CODEX_NATIVE_BIN:-$(_cxd_real_codex || true)}"
if [ -z "$_cxd_bin" ] || [ ! -x "$_cxd_bin" ]; then
  printf '%s\n' "⛔ cxd: 找不到官方 codex 二进制（PATH 上除了 CodexBar 的 wrapper 没有别的 \`codex\`）。" \
    "   修：装官方 CLI（\`npm i -g @openai/codex\`），或用 CODEX_NATIVE_BIN 指到它。" >&2
  exit 78
fi
exec "$_cxd_bin" "$@"

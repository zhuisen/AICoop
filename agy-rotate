#!/usr/bin/env python3
"""Antigravity(agy) 账号池 CLI —— 收编 / 看额度 / 换号 / 选号。

    agy-rotate login [label]   加一个号：保住当前的 → 起 agy 让你登录新号 → 回来自动收编
    agy-rotate login --current 只收编**当前登录**的号，不起 agy（第一次建池用它）
    agy-rotate list            列出池 + 上次读到的额度
    agy-rotate quota [--json]  刷新全池额度（零消耗，不需要 agy 在跑）
    agy-rotate switch <label>  把某个号装回 agy 的登录态
    agy-rotate pick [--why]    按额度挑一个号（自动切用；只打印 label，不动凭证）
    agy-rotate auto            = pick + 必要时 switch（`bin/agy` 启动前调它）
    agy-rotate rename <旧> <新>
    agy-rotate remove <label>

## 加号为什么不自己实现 OAuth

★ agy **没有** login/logout 子命令（`agy --help` 实测），登录只能在 TUI 里走。
  我们不"代替"用户登录，只把他前后那两步接上：**先把当前号存进池**（`/logout` 会就地
  清掉唯一那份登录态，不先存就丢了），再在他登完之后自动收编。
★ 也因此不需要把 client_secret 常驻在代码里 —— 而这个仓库是公开的。

## ★★ 换号只对**下一次启动**生效

  agy 在启动时读 `antigravity-oauth-token`，之后不再读。所以：
  - 自动切发生在 `bin/agy` **exec 真身之前**，那是唯一能保证本次会话用对号的时刻；
  - 对**已经开着**的 agy 会话，换文件不影响它 —— 这是设计事实，文案必须这么写，
    不能让用户以为点一下就切走了正在跑的那个。
"""
import json
import os
import re
import subprocess
import sys
import time

#: 探针的硬上限。实测一次约 30s（agy 起进程 ~10s + 生成 ~8s），留三倍余量。
#: ★ 必须有上界：没有的话一个卡住的 agy 会把 GUI 的按钮永远钉在「探测中…」。
PROBE_TIMEOUT = int(os.environ.get("AGY_PROBE_TIMEOUT", "120"))
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from agy import pool as P                                    # noqa: E402


def _fmt_pct(v):
    return "—" if v is None else "%.1f%%" % (float(v) * 100)


def _fmt_reset(s):
    """`2026-09-13T10:31:36Z` → 本地 `09-13 18:31`。★ 显示一律转本地：
    用户看的是自己的钟，而服务端给的是 UTC —— 混着看会差 8 小时。"""
    if not s:
        return "—"
    try:
        import datetime
        d = datetime.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone()
        return d.strftime("%m-%d %H:%M")
    except Exception:                                        # noqa: BLE001
        return s


def _accounts(pool):
    return pool.setdefault("accounts", {})



#: 运行日志。★★ 用户 2026-09-14：「运行日志也需要更新，例如我不同账号的探针、刷新等
#: 详细的操作，成功与否都要显示出来」。此前 agy 这一侧**一个字都不落盘** ——
#: 界面上点了什么、结果如何，事后完全无从复盘（codex 那侧有 proxy.log/quotad.log）。
#:
#: ★ 格式与 `quotad.log` 对齐（`[名字 时:分:秒] 正文`），日志页按同一套渲染，
#:   `✗` 开头的行会被染红。落点跟 store 走，不跟脚本走（脚本会被打进 app）。
AGY_LOG = P.STORE / "agy.log"
#: 只留最近这么多行。★ 有上界是必须的：这个文件由 GUI 按钮驱动，
#:   没人会去轮转它，放任下去就是一个只增不减的文件。
_LOG_KEEP = 800


def _log(msg):
    """往运行日志追一行。★ **fail-open** —— 写不了日志绝不能让操作本身失败。"""
    try:
        line = "[agy %s] %s\n" % (time.strftime("%m-%d %H:%M:%S"), msg)
        with open(AGY_LOG, "a", encoding="utf-8") as fh:
            fh.write(line)
        # 超了就裁一次。按行裁、整份重写：这个文件很小（几十 KB），不值得上轮转器。
        if AGY_LOG.stat().st_size > 200_000:
            keep = AGY_LOG.read_text(encoding="utf-8", errors="replace").splitlines()[-_LOG_KEEP:]
            AGY_LOG.write_text("\n".join(keep) + "\n", encoding="utf-8")
    except Exception:                                    # noqa: BLE001
        pass


def _mark_live(pool):
    """把「当值号」记进池 -> sub。

    ★ 池文件本身认不出谁在当值 —— 那个事实只写在 agy 的登录态文件里。
      所以每条**知道**它的命令都顺手记一次，前端才不用自己去解 JWT。
    ★ 它可能过时（用户在 agy 里 `/logout` 换了号而没跑我们的命令）。
      所以字段名是 `live_seen` 不是 `live`：**上次我们看到的**，下次 `quota` 会纠正。
    """
    sub = (P.claims(P.read_live()) or {}).get("sub")
    pool["live_seen"] = sub
    return sub


def _by_label(pool, key):
    """label 或 sub 前缀都认。★ 与 codex 池同一条教训：**label 是可改的显示名**，
    所以内部一律存 `sub`，只在查找时接受 label。"""
    accs = _accounts(pool)
    if key in accs:
        return key
    hit = [s for s, a in accs.items() if a.get("label") == key]
    if len(hit) == 1:
        return hit[0]
    if len(hit) > 1:
        sys.exit("★ 有 %d 个号都叫 '%s' —— 先 rename 一个再来" % (len(hit), key))
    pre = [s for s in accs if s.startswith(key)]
    return pre[0] if len(pre) == 1 else None


def _adopt(label=None, quiet=False):
    """把**当前登录**的号收进池 -> (sub, 是否新号)。收不了就退出并说清楚为什么。"""
    live = P.read_live()
    if not live:
        sys.exit("读不到当前登录态 —— 先在 agy 里登录一个号\n"
                 "  （主存储是 macOS 钥匙串 %s/%s，兜底文件 %s）"
                 % (P.KEYRING_SVC, P.KEYRING_ACCT, P.LIVE))
    cl = P.claims(live)
    sub, email = cl.get("sub"), cl.get("email")
    if not sub:
        sys.exit("当前凭证里没有 id_token.sub —— 认不出这是哪个号，拒绝收编")
    pool = P.load()
    accs = _accounts(pool)
    fresh = sub not in accs
    label = label or accs.get(sub, {}).get("label") or (email or sub).split("@")[0]
    P.write_cred(sub, live)
    accs[sub] = {**accs.get(sub, {}), "label": label, "email": email,
                 "adopted_at": accs.get(sub, {}).get("adopted_at") or int(time.time()),
                 "updated_at": int(time.time())}
    with P._lock(P.POOL):
        P.save(pool)
    if not quiet:
        print("%s [%s] %s" % ("已收编" if fresh else "已更新", label, email or sub[:12]))
    return sub, fresh


def cmd_login(args):
    """加一个号：先保住当前的，再起 agy 让你登录新号，回来自动收编。

    ★★★ **必须先把当前号收进池再清登录态。** agy 的登录态只有一份，清掉
      （我们的 `clear_live` 或用户的 `/logout`）就没了 —— 没有先备份的话，那个号就此丢了，
      用户要重新走一遍浏览器 OAuth 才能拿回来。这一步不是"顺手做的"，它是这条命令存在的理由之一。
    ★★ 2026-10-14 起由我们先清空、agy 从未登录启动，不再让用户在进程内 `/logout` 换号。

    ★ agy **没有** login/logout 子命令（`agy --help` 实测），登录只能在 TUI 里走。
      所以我们不"代替"用户登录，只是把他前后那两步（保住旧的、收编新的）接上。

    `--current` 只收编当前登录的号，不起 agy —— 第一次建池用它。
    """
    only = "--current" in args
    label = next((a for a in args if not a.startswith("-")), None)
    before, _ = _adopt(label if only else None)
    if only:
        _hint_next(P.load())
        return

    pool = P.load()
    before_label = _accounts(pool).get(before, {}).get("label")
    real = Path(os.environ.get("AGY_REAL", str(Path.home() / ".local" / "bin" / "agy")))
    if not real.exists():
        sys.exit("找不到 agy（%s）" % real)
    # ★★ 先清空登录态，让 agy **从未登录开始**，不在进程内 `/logout` 换号（见 `P.clear_live`）。
    #   前提是旧号已经真的存进池 —— 存不进就不清，退回旧流程，宁可多一步也不丢号。
    saved = before is None or P.read_cred(before) is not None
    print("\n接下来会启动 agy。在里面：")
    if saved:
        print("  1. 按提示在浏览器里登录**新的** Google 账号（不用 `/logout`）")
    else:
        print("  1. 输入 `/logout`，再按提示在浏览器里登录**另一个** Google 账号")
    print("  2. 退出 agy（Ctrl-D / `/quit`）——回来我会自动把新号收进池")
    if before:
        print("\n★ 刚才那个号（%s）已经存进池里了，没登成会自动装回去。" % before_label)
    print("★ 先退掉其它开着的 agy —— 它们可能把旧号写回钥匙串，新开的 agy 就又是旧号了。")
    try:
        input("准备好就按回车（Ctrl-C 放弃）… ")
    except (EOFError, KeyboardInterrupt):
        print("\n已放弃 —— 池里那份没动。")
        return

    if saved and before and not P.clear_live():
        print("  ⚠️ 没清掉当前登录态 —— 进去之后先 `/logout` 再登新号。")
    # ★ 用 subprocess 而不是 execv：execv 之后本进程就没了，**回不来收编**。
    #   交互态要保住 TTY，所以不接管任何一条流。
    subprocess.run([str(real)], check=False)

    after_cred = P.read_live()
    after = (P.claims(after_cred) or {}).get("sub")
    if not after:
        # ★ 这条曾是**假阴性**（2026-09-13 用户实报）：登录其实成功了，
        #   只是我们读的是文件、而 agy 把新凭证写进了钥匙串。`read_live()` 现在
        #   钥匙串优先，所以走到这里才是真的没读到。措辞也跟着改成两种可能。
        # ★★ 登录态是我们清的，没登成就得装回去 —— 否则用户退出来发现 agy 谁都没登。
        old = P.read_cred(before) if before else None
        if old and P.read_live() is None:
            where = P.install_live(old)
            print("\n✗ 没有登录新号 —— 已把原来那个号（%s）装回去（落点 %s）。"
                  "\n  池里那份没丢。" % (before_label, where))
        else:
            print("\n✗ 回来之后读不到登录态 —— 登录没完成，或者钥匙串读不出来。"
                  "\n  池里那份没丢：`agy-rotate switch %s` 装回去。" % before_label)
        return
    if after == before:
        # ★ 三态里最容易被讲错的那个：**没换号** ≠ 失败，也 ≠ 成功加号。
        print("\n还是原来那个号（又登了同一个账号，或者别的 agy 进程把它写回了钥匙串）"
              "—— 池没有变化。")
        return
    sub, fresh = _adopt(label)
    print("  ★ 新号已成为当前登录态。" if fresh else "  ★ 这个号本来就在池里，已更新凭证。")
    _hint_next(P.load())


def _hint_next(pool):
    n = len(_accounts(pool))
    if n < 2:
        print("  ★ 池里只有一个号，轮换还没有意义 —— `agy-rotate login` 再加一个。")
    else:
        print("  池里现在 %d 个号。`agy-rotate quota` 看额度，`agy --as <label>` 指定号跑。" % n)


def _refresh_one(sub, acc, pool):
    """→ (cred, err)。必要时刷新并**写回池里的凭证**（不碰 agy 的登录态）。"""
    cred = P.read_cred(sub)
    if not cred:
        return None, "凭证文件不在（auth/agy/%s.json）" % sub
    if not P.expired(cred):
        return cred, ""
    fresh, err = P.refresh(cred, pool)
    if err:
        return None, err
    P.write_cred(sub, fresh)
    return fresh, ""


def _quota_anchors_mod():
    """锚点账本模块（`traffic/quota_anchors.py`），按路径加载；取不到返回 None。
    **纯附加，绝不抛** —— 同 `agy-quota::_quota_anchors_mod` 与 2026-09-05「附加功能搞挂主路径」。"""
    try:
        import importlib.util
        f = Path(os.path.realpath(__file__)).parent / "traffic" / "quota_anchors.py"
        if not f.is_file():
            return None
        spec = importlib.util.spec_from_file_location("quota_anchors", str(f))
        if spec is None or spec.loader is None:
            return None
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        return m
    except Exception:       # noqa: BLE001 — 纯附加
        return None


def _note_pool_anchors(sub, groups, now, billed=None):
    """按号、按桶记一次读数进锚点账本 → `{bucketId: verdict}`（带它描述的 `reset`）。

    ★★ 存在的理由（2026-10-15 实测）：云端摘要里**没用过的桶** `resetTime` 恒为「读数时刻 + 整窗」，
      每 3 分钟刷新就往后挪 3 分钟 —— 卡上那个 ↻4h5xm 永远走不到 0。本机 RPC 时代
      `agy-quota::_note_anchors` 记过账、UI 能说「未启动」；额度改走云端按账号读之后这条没接上，
      倒计时就又成了没有任何标记的假值。判据不变，只是换了个喂数的地方。
    ★ key 带 `sub`：云端是**按账号**读的，一个号的窗口与另一个号无关（本机 RPC 只有当值号）。
    ★ `billed` = 这次探针真的计进了这个桶 ⇒ `note_billed`（同 codex `_mark_billed_anchor`）：
      窗口是我们亲手启动的，这是演绎，不必再等 900s 从时间序列里推一遍。
    """
    try:
        mod = _quota_anchors_mod()
        if mod is None:
            return None
        out = {}
        for g in groups or []:
            for b in g.get("buckets") or []:
                bid = b.get("bucketId") or b.get("window")
                fr, rs = b.get("remainingFraction"), P._iso_ts(b.get("resetTime"))
                if not bid or not isinstance(fr, (int, float)) or not rs:
                    continue
                key = "pool/%s/%s" % (sub, bid)
                v = mod.note("agy", key, rs, 100.0 * (1 - float(fr)), now=now)
                if billed and bid == billed:
                    v = mod.note_billed("agy", key, rs, now=now)
                v["reset"] = int(rs)
                out[bid] = v
        return out or None
    except Exception:       # noqa: BLE001 — 纯附加
        return None


def _store_quota(sub, a, groups, err, billed=None):
    """一次额度读数落进池里这个号 → 旧形状投影 `q`（失败为 None）。`quota` 与探针共用这一份。"""
    q = P.quota_by_group(groups) if not err else None
    a["quota_summary"] = groups if not err else None
    a["quota"] = q if not err else None
    a["quota_err"] = err or None
    a["quota_err_reason"] = getattr(err, "reason", None)
    a["quota_err_url"] = getattr(err, "url", None)
    a["quota_at"] = int(time.time())
    if not err:
        # ★ 判定是**兄弟键**且自带它描述的 `reset`（同 codex `slot["quota_anchor"]`）：
        #   前端核身份，对不上就不用 —— 拿旧窗口的判定解释新窗口，渲染出来一模一样。
        anc = _note_pool_anchors(sub, groups, a["quota_at"], billed=billed)
        if anc:
            a["quota_anchor"] = anc
    return q


def _maybe_tier(a, cred, now=None):
    """档位（Pro / Ultra）一天最多读一次；读不到就**留着上次的**，绝不清空成 free。"""
    now = time.time() if now is None else now
    if a.get("plan") and now - float((a.get("tier") or {}).get("at") or 0) < P.TIER_TTL:
        return
    try:
        tier, err = P.fetch_tier(cred["token"]["access_token"])
    except Exception:       # noqa: BLE001 — 档位是附加信息，绝不拖垮额度刷新
        return
    if tier and not err:
        a["tier"] = {"id": tier["id"], "name": tier["name"], "at": int(now)}
        a["plan"] = tier["plan"]


def _gemini_5h(groups):
    """Gemini 组的 5h 桶 → `(bucketId, 剩余 0~1, reset epoch)`；没有就 `(None, None, None)`。"""
    for g in groups or []:
        if not str(g.get("displayName", "")).lower().startswith("gemini"):
            continue
        for b in g.get("buckets") or []:
            if str(b.get("window", "")) == "5h" and isinstance(b.get("remainingFraction"), (int, float)):
                return (b.get("bucketId") or "5h", float(b["remainingFraction"]),
                        P._iso_ts(b.get("resetTime")))
    return None, None, None


def cmd_quota(args):
    want_json = "--json" in args
    pool = P.load()
    _t0 = time.time()
    accs = _accounts(pool)
    if not accs:
        sys.exit("池是空的 —— 先 `agy-rotate adopt`")
    live_sub = _mark_live(pool)
    out = []
    # ★ 各号**并行**取（2026-09-23，用户：「gemini 的额度刷新不及时」）。
    #   逐号串行时全程几乎都在等网络（实测 3 个号 8.4s，历史记录 18.6s），而每个号的
    #   刷 token + 取额度只碰它自己的凭证文件与它自己那个 dict —— 互不相干，没有共享写。
    #   池文件仍只在下面**统一落盘一次**（持锁），所以并行不改变落盘的形状。
    from concurrent.futures import ThreadPoolExecutor

    def _fetch(item):
        sub, a = item
        cred, err = _refresh_one(sub, a, pool)
        if err:
            return sub, a, None, err, True
        groups, err = P.fetch_quota(cred["token"]["access_token"])
        _maybe_tier(a, cred)
        return sub, a, groups, err, False

    with ThreadPoolExecutor(max_workers=max(1, min(8, len(accs)))) as ex:
        fetched = list(ex.map(_fetch, list(accs.items())))
    for sub, a, groups, err, cred_failed in fetched:
        # ★ 错误的**结构**（reason / 验证链接）落兄弟键，成败都写 —— 成功时清掉，
        #   否则一个早已验证过的号会一直挂着「需验证」。
        a["quota_err_reason"] = getattr(err, "reason", None)
        a["quota_err_url"] = getattr(err, "url", None)
        if cred_failed:
            a["quota_err"] = err
            out.append({"sub": sub, "label": a.get("label"), "err": err})
            continue
        # ★★ 失败态一律**不写数字**：`0` 是"用光了"的合法值，一旦某条失败路径悄悄写出 0，
        #    UI 会画一条正常的红条，而用户没有第二个办法分辨。同 grok/agy 额度那条降级契约。
        # ★★★ `quota_summary` 是**完整摘要**（含周窗口，2026-09-15 起）；
        #    `quota` 是它的投影，只为选号与 CLI 打印保留旧形状。
        #    两者只在 `quota_by_group` 里算一次 —— 不会分叉成两份事实。
        q = _store_quota(sub, a, groups, err)
        out.append({"sub": sub, "label": a.get("label"), "live": sub == live_sub,
                    "quota": q, "err": err or None})
    # ★★★ **池级「上次尝试过」的时刻，成败都写。**
    #
    # 判「该不该重取」绝不能看各号的 `quota_at`：上面那条失败分支 `continue` 掉了，
    # **不写 `quota_at`** —— 于是一个坏掉的号会让"最旧的 quota_at 过期了吗"**永远为真**，
    # 前端心跳就变成每 30s 起一次 18.6s 的子进程往云端猛打。
    # 这与 B46 的 `_reset_crossed` 是**同一个形状**：拿"成功的副作用"当"尝试过"的判据，
    # 失败时条件自我锁死成放大器，而且**没有任何症状**（日志安静、UI 照常）。
    #
    # ★ 「我们试过了」是一条独立的事实，就该独立写下来，不从别的字段反推
    #   （同 §7.1「先列出那一刻我们已经知道但没写下来的事」）。
    pool["quota_ran_at"] = int(time.time())
    with P._lock(P.POOL):
        P.save(pool)
    for _s, _a in _accounts(pool).items():
        _log("quota [%s] %s" % (_a.get("label"),
             ("✓ " + "、".join("%s %s" % (k, _fmt_pct(v["remaining"]))
                               for k, v in (_a.get("quota") or {}).items()))
             if not _a.get("quota_err") else "✗ " + str(_a.get("quota_err"))[:70]))
    if want_json:
        print(json.dumps({"accounts": out, "at": int(time.time())}, ensure_ascii=False))
        return
    for r in out:
        tag = " ←当前" if r.get("live") else ""
        if r.get("err"):
            print("  [%-10s] ✗ %s%s" % (r["label"], r["err"], tag))
            continue
        parts = ["%s %s(重置 %s)" % (g, _fmt_pct(v["remaining"]), _fmt_reset(v["reset"]))
                 for g, v in (r["quota"] or {}).items()]
        print("  [%-10s] %s%s" % (r["label"], " · ".join(parts) or "无额度信息", tag))


def cmd_list(args):
    pool = P.load()
    accs = _accounts(pool)
    if not accs:
        print("池是空的 —— `agy-rotate adopt` 收编当前登录的号")
        return
    live_sub = (P.claims(P.read_live()) or {}).get("sub")
    for sub, a in accs.items():
        q = a.get("quota") or {}
        g = (q.get("gemini") or {})
        print("  %-10s %-28s gemini %s  重置 %s%s%s" % (
            a.get("label"), (a.get("email") or sub)[:28],
            _fmt_pct(g.get("remaining")), _fmt_reset(g.get("reset")),
            "  ←当前" if sub == live_sub else "",
            "  ✗" + a["quota_err"] if a.get("quota_err") else ""))


def _score(a):
    """选号用的剩余比例。★ 只看 `gemini` 组 —— 它是 agy 的主力池（实测 20/27 个模型），
    而 claude 组那 3 个模型用不到时永远是 1.0，掺进来会让排序失去分辨力。
    取不到额度的号排在**最后**：不是「它满额」，是「我们不知道」。"""
    q = (a.get("quota") or {}).get("gemini") or {}
    r = q.get("remaining")
    return float(r) if isinstance(r, (int, float)) else -1.0


def cmd_pick(args):
    """打印下次启动会用哪个号。★ 调 `pool.pick` —— 与 `auto` / `next` 同一份实现。"""
    pool = P.load()
    if not _accounts(pool):
        sys.exit("池是空的")
    live_sub = (P.claims(P.read_live()) or {}).get("sub")
    sub, why = P.pick(pool, live_sub)
    if "--why" in args:
        cur = _accounts(pool).get(live_sub) or {}
        print("当前 [%s] → 选 [%s]（%s）" % (cur.get("label", "—"),
              (_accounts(pool).get(sub) or {}).get("label", "—"), why))
    if sub:
        print(_accounts(pool)[sub].get("label") or sub)


def cmd_next(args):

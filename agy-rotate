def cmd_pin(args):
    """`agy-rotate pin [<label…>|--toggle <l>|--clear|--json]` —— 置顶，与 `codex-rotate pin` 同一套语义。

    默认容量最高优先；点亮哪个号才优先用哪个，可多个、按点击先后排队。
    ★ 真源在池里（wrapper 在 app 没开时也要读），存 **sub** 不存 label。
    """
    pool = P.load()
    accs = _accounts(pool)
    pinned = [x for x in (pool.get("pinned") or []) if x in accs]
    if "--json" in args:
        print(json.dumps({"pinned": [accs[x].get("label") for x in pinned]}, ensure_ascii=False))
        return
    if "--clear" in args:
        pool.pop("pinned", None)
    elif "--toggle" in args:
        i = args.index("--toggle")
        name = args[i + 1] if i + 1 < len(args) else ""
        sub = _by_label(pool, name)
        if not sub:
            sys.exit("池里没有 '%s'" % name)
        if sub in pinned:
            pinned.remove(sub)
        else:
            pinned.append(sub)
        pool["pinned"] = pinned
        if not pinned:
            pool.pop("pinned", None)
    elif args:
        subs = []
        for name in args:
            sub = _by_label(pool, name)
            if not sub:
                sys.exit("池里没有 '%s'" % name)
            subs.append(sub)
        pool["pinned"] = subs
    else:
        print("置顶：%s" % ("、".join(accs[x].get("label") for x in pinned) or "（无 —— 容量最高优先）"))
        return
    with P._lock(P.POOL):
        P.save(pool)
    now_p = pool.get("pinned") or []
    _log("pin → %s" % ("、".join(accs[x].get("label") for x in now_p) or "（清空）"))
    print("置顶：%s" % ("、".join(accs[x].get("label") for x in now_p) or "（无 —— 容量最高优先）"))


def cmd_borrow(args):
    """`agy-rotate borrow --on|--off|--status [--json]` —— 池子空时借不借一个已停用的号。

    ★ 存**反向**（`borrow_off`）：缺省（无键）= 允许借用 = 既有行为；恢复默认是**删键**。
      与 `codex-rotate borrow` 同一条理由。
    """
    pool = P.load()
    if "--on" in args:
        pool.pop("borrow_off", None)
    elif "--off" in args:
        pool["borrow_off"] = True
    if "--on" in args or "--off" in args:
        with P._lock(P.POOL):
            P.save(pool)
        _log("borrow → %s" % ("关" if pool.get("borrow_off") else "开"))
    st = {"borrow": not pool.get("borrow_off")}
    if "--json" in args:
        print(json.dumps(st))
    else:
        print("池子空时借用已停用的号：%s" % ("开" if st["borrow"] else "关"))


def cmd_switch(args):
    if not args:
        sys.exit("usage: agy-rotate switch <label>")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    cred, err = _refresh_one(sub, _accounts(pool)[sub], pool)
    if err:
        sys.exit("✗ %s" % err)
    live_sub = _mark_live(pool)
    if live_sub == sub:
        print("[%s] 已经是当前号，没动" % _accounts(pool)[sub].get("label"))
        return
    where = P.install_live(cred)
    _mark_live(pool)
    if "--for-this-run" not in args:
        # ★★★ 记下**用户显式要的那个号**。`live_seen` 回答"钥匙串里现在是谁"，
        #   而这个回答"用户要的是谁" —— 两件事，合并就没法发现被劫持。
        #   `auto` 据此在钥匙串被别的 agy 进程写回之后**把用户的选择装回去**，
        #   而不是看到"当前号额度还够"就 return（那等于静默撤销用户的操作）。
        #   `bin/agy` 的 `--as` 传 `--for-this-run`：那是一次性指定，不是长期偏好。
        pool["live_wanted"] = sub
    with P._lock(P.POOL):
        P.save(pool)
    lab = _accounts(pool)[sub].get("label")
    _log("switch → [%s]（落点 %s）" % (lab, where))
    print("已切到 [%s] —— ★ 只对**下一次启动的** agy 生效，已经开着的会话不受影响" % lab)
    if where != "keyring":
        # ★★ 不许静默。2026-09-13 之前这条路**一直**只写文件，而 agy 只读钥匙串 ——
        #   换号是空操作，命令却照常打印「已切到」。宁可多说一句，也不能再让
        #   「我们写成功了」冒充「agy 真的换了号」。
        _log("✗ switch [%s] 只写到兜底文件 —— agy 很可能仍在用原来那个号" % lab)
        print("  ⚠️ 没能写进钥匙串（agy 的主存储），只写了兜底文件 —— "
              "agy 很可能仍在用原来那个号。\n"
              "     钥匙串被锁住时会这样：解锁登录钥匙串后重试一次。")


def cmd_auto(args):
    """选号 + 必要时换凭证。`bin/agy` 在 exec 真身之前调它。

    ★ 整体 fail-open：选不出来/刷不动，就让 agy 用**当前**登录态照常跑。
      轮换是增益，不是前置条件 —— 把它做成前置条件就会出现「CodexBar 坏了导致 agy 用不了」。
    """
    try:
        pool = P.load()
        # ★★★ **开关必须在这里真的被读到。** 只把状态存进池、而 `auto` 照切，
        #   就是本仓那条「写入侧标志会撒谎」——界面说关着、wrapper 照样换号，
        #   而用户完全看不出来。闸 `tests/test_agy_actions.py` 打在这两行上。
        if pool.get("auto_off"):
            return
        if len(_accounts(pool)) < 2:
            return
        live_sub = (P.claims(P.read_live()) or {}).get("sub")
        # ★★ 「兑现用户显式 switch 的号」已并进 `pool.pick`（reason=wanted）：钥匙串被别的
        #   常驻 agy 写回时仍会装回你选的号 —— 但**只在那个号还可用时**。旧实现无条件兑现且
        #   兑现后直接 return，一次手动切换就让轮换永久失效，还会把见底的号装回去。
        sub, why = P.pick(pool, live_sub)
        if not sub or sub == live_sub:
            return
        a = _accounts(pool)[sub]
        cred, err = _refresh_one(sub, a, pool)
        if err:
            return
        where = P.install_live(cred)
        _mark_live(pool)
        with P._lock(P.POOL):
            P.save(pool)
        # ★ 落点写进这一行：只写了文件的话这次自动切**没有生效**，
        #   而 agy 照跑、用户看到的一切都正常 —— 那正是要避免的那种"成功"。
        verb = {"wanted": "恢复成你选的", "borrow": "借用已停用的"}.get(why, "自动切到")
        _log("auto %s [%s]（剩余 %s，%s，落点 %s）"
             % (verb, a.get("label"), _fmt_pct(_score(a)), why, where))
        print("[codexbar] agy %s [%s]（剩余 %s）%s"
              % (verb, a.get("label"), _fmt_pct(_score(a)),
                 "" if where == "keyring" else " ⚠️ 只写了兜底文件，可能未生效"),
              file=sys.stderr)
    except Exception:                                 # noqa: BLE001
        return


def cmd_rename(args):
    if len(args) < 2:
        sys.exit("usage: agy-rotate rename <old> <new>")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    new = args[1].strip()
    if not new or any(c.isspace() for c in new):
        sys.exit("新名字不能为空、不能含空格（它要当命令行参数用）")
    accs = _accounts(pool)
    if any(s != sub and a.get("label") == new for s, a in accs.items()):
        sys.exit("'%s' 已经被别的号占了" % new)
    accs[sub]["label"] = new
    with P._lock(P.POOL):
        P.save(pool)
    print("renamed → %s" % new)


def cmd_remove(args):
    if not args:
        sys.exit("usage: agy-rotate remove <label>")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    lbl = _accounts(pool)[sub].get("label")
    live_sub = (P.claims(P.read_live()) or {}).get("sub")
    if sub == live_sub:
        sys.exit("[%s] 正是当前登录的号 —— 先 switch 到别的号再移除，"
                 "否则你会既不在池里、也没有别的登录态可回。" % lbl)
    del _accounts(pool)[sub]
    with P._lock(P.POOL):
        P.save(pool)
    try:
        P.cred_path(sub).unlink()
    except OSError:
        pass
    print("已移除 [%s]" % lbl)


def cmd_health(args):
    """**零消耗**地问 Google：池里每个号的凭证还有效吗。

    ★★★ 这是 codex `health` 的 agy 版，但**机制完全不同**，别照搬：
      codex 是问 OpenAI「这个 token 被作废了吗」；agy 这边是
      **拿 refresh_token 换一次 access_token，再打一次 `fetchAvailableModels`**。
      两步都成功才算这个号真的还能用 —— 只刷不打，换来的 token 可能对 API 没权限。

    ★★ **刷新是安全的，这一条必须实测过才敢写。** Google 默认**不轮换** refresh_token
      （响应里没有那个字段，2026-09-13 实测），所以我们刷不会作废 agy 自己手里那份。
      ⚠️ 与本仓对 grok 的铁律**正好相反**（grok 单次有效、绝不刷）——
      两家行为是反的，照搬任何一边都会杀号。

    零消耗：`fetchAvailableModels` 不产生 token 用量，只回额度与模型清单。
    """
    want_json = "--json" in args
    pool = P.load()
    accs = _accounts(pool)
    if not accs:
        sys.exit("池是空的 —— 先 `agy-rotate login --current`")
    live = _mark_live(pool)

    # ★★ **按 label 限定范围**（2026-09-16 补）。此前这里**完全不读 `args` 里的名字** ——
    #   `agy-rotate health <label>` 会**静默地**检查全部号：用户以为限定了范围，其实没有。
    #   零消耗所以没烧钱，但这是本仓最不能容忍的那一类「参数被静默吃掉」：
    #   **限定了和没限定，输出上分辨不出来**（同「点错位置和没点中长得一模一样」）。
    #   ★ 认不出的名字**直接报错退出**，不静默退回全池 —— 打错一个字母就该看见。
    names = [x for x in args if not x.startswith("-")]
    if names:
        want = {}
        for n in names:
            sub = _by_label(pool, n)
            if not sub or sub not in accs:
                sys.exit("池里没有这个号：%s（`agy-rotate list` 看有哪些）" % n)
            want[sub] = accs[sub]
        accs = want

    rows = []
    for sub, a in accs.items():
        cred = P.read_cred(sub)
        if not cred:
            rows.append((sub, a, "no_cred", "池里没有这个号的凭证文件"))
            continue
        cred, err = P.refresh(cred, pool)
        if err:
            # ★ `invalid_grant` = 凭证被作废（掉登录），与「网络不通」必须分开：
            #   前者要重新走浏览器 OAuth，后者等一会儿再来。合并成一句话，
            #   用户就会对着一个网络抖动去重新登录。
            kind = "revoked" if "invalid_grant" in err else "error"
            rows.append((sub, a, kind, err))
            continue
        P.write_cred(sub, cred)
        q, qerr = P.fetch_quota(cred["token"]["access_token"])
        rows.append((sub, a, "ok" if not qerr else "api_error", qerr or ""))
        if not qerr:
            a["quota_summary"] = q
            a["quota"] = P.quota_by_group(q)
            a["quota_at"] = int(time.time())
    a_now = int(time.time())
    for sub, a, kind, _d in rows:
        # ★ 独立兄弟键，与 `quota` 分开：`quota` 会被别的路径整体替换，
        #   健康结论跟着它走就会在下一次刷新后凭空消失（同 codex 的 `last_probe`）。
        a["last_health"] = {"at": a_now, "ok": kind == "ok", "kind": kind}
    with P._lock(P.POOL):
        P.save(pool)
    if want_json:
        print(json.dumps([{"sub": s, "label": a.get("label"), "kind": k, "detail": d}
                          for s, a, k, d in rows], ensure_ascii=False))
        return
    for _s, a, kind, detail in rows:
        _log("health [%s] %s%s" % (a.get("label"), "✓ 还能用" if kind == "ok" else "✗ " + kind,
                                   ("：" + detail[:70]) if detail and kind != "ok" else ""))
    TXT = {"ok": "✓ 还能用", "revoked": "✗ 掉登录（要重新走浏览器 OAuth）",
           "no_cred": "✗ 池里没有凭证文件", "api_error": "⚠️ 刷新成功但 API 打不通",
           "error": "⚠️ 刷新失败"}
    for sub, a, kind, detail in rows:
        print("  [%s]%s %s%s" % (a.get("label"), " ←当前" if sub == live else "",
                                 TXT.get(kind, kind), (" — " + detail[:80]) if detail else ""))
    bad = [a.get("label") for _s, a, k, _d in rows if k != "ok"]
    print("  %d/%d 个还能用%s" % (len(rows) - len(bad), len(rows),
                                  ("；有问题的：" + "、".join(bad)) if bad else ""))


#: 探针问的话与判据。★ 与 codex 探针同一条纪律：**判据是「模型真吐出字」**，
#: 不是退出码 0 —— 200/exit 0 只说明请求被受理，流中途断掉照样 0。
PROBE_ASK = "Reply with exactly: ok"


#: agy 自己的日志目录。探针的**归属证据**只能取自这里 —— 我们自己的记录在这件事上
#: 恰好是不可信的那一方（我们记的是"打算探谁"，不是"实际跑成了谁"）。
AGY_LOG_DIR = Path(os.environ.get(
    "AGY_LOG_DIR", str(Path.home() / ".gemini" / "antigravity-cli" / "log")))

#: 进程启动时刻与日志文件名时间戳的允许偏差（秒）。agy 在启动那一刻建日志，
#: 但两者不保证同一秒。
_LOG_SKEW = 5


def _run_identity(started_at):
    """这一次我们起的 `agy` **实际认证成了哪个账号**（email）。认不出返回 `None`。

    ★★★ 为什么必须有（2026-09-16 补）：`_probe_one` 是"对**当前钥匙串里**那个号跑一次"，
      而钥匙串是被**多个常驻 agy 进程并发写的单槽** —— 本机实测此刻有 **7 个**常驻 agy，
      最老的跑了 8 天 23 小时，且**身份并不相同**（日志实证：2 个是 A、1 个是 B）。
      它们各自在自己 access token 到期时把自己的身份整份写回钥匙串。
      于是「我们装进去 B → 起 agy」中间存在一个窗口，B 可能已被冲掉 ⇒
      **agy 实际以 A 的身份跑完，而我们把结果和 15k token 记在 B 头上**。
      本机 `agy.log` 里「钥匙串被别的 agy 进程写回过」**已经出现 9 次**，最近一次就在当天 ——
      这不是理论风险。

    ★ 判据与 `agy-quota::pid_identity` **同源**：取 agy 自己日志里的
      `applyAuthResult: email=`。那边守的是"周额度挂在谁的卡上"，这边守的是
      "这 15k token 记在谁头上" —— 同一条纪律：**归属要有证据，没证据就不归属。**
      ⚠️ 那边已经有闸而这边一直没有，正是这次要补的缺口。
    """
    try:
        best = None
        for f in AGY_LOG_DIR.glob("cli-*.log"):
            m = re.match(r"cli-(\d{8}_\d{6})\.log$", f.name)
            if not m:
                continue
            ts = time.mktime(time.strptime(m.group(1), "%Y%m%d_%H%M%S"))
            if abs(ts - started_at) <= _LOG_SKEW:
                # ★ 同一窗口里有两份 ⇒ **认不出就不猜**（同 agy-quota 那条）。
                #   并发起两个 agy 时会撞上，猜错比认不出更糟。
                if best is not None:
                    return None
                best = f
        if best is None:
            return None
        found = re.findall(r"applyAuthResult: email=([^\s,]+)",
                           best.read_text(errors="replace"))
        # 取**最后**一条：进程中途换号时早先那条已过期。
        return found[-1] if found else None
    except (OSError, ValueError):
        # ★★ **只吞真正的"读不到"**（文件没了 / 时间戳不是那个格式）。
        #   第一版这里写的是裸 `except Exception`，而 `agy-rotate` **当时没有 `import re`** ⇒
        #   `re.match` 抛 `NameError` ⇒ 被整个吞掉 ⇒ `ran_as` 恒 `None` ⇒
        #   **归属核对静默地从不工作**，而探针输出、退出码、日志全都完全正常。
        #   本仓已经记过一模一样的形状（`_quota_anchors_mod()` 的整体 fail-open
        #   吞掉了 `Path` 未导入，账本静默从不记账）—— 我在修别的 bug 时又犯了一次。
        #   闸：`tests/test_agy_probe_attribution.py::TheIdentityLookupIsActuallyWired`。
        return None


def _err_gist(stderr):
    """把 agy 的 stderr 压成一句**有用**的话。

    ⚠️ 原来这里写的是 `stderr[-160:]` —— 取**末尾**。2026-09-16 实测：
      eligibility 被拒时 agy 吐的是一大段 JSON + 一个很长的 Google 登录 URL，
      于是留在记录里的只有 `…flowName=GlifWebSignIn&authuser`，
      而真正那句 **"Verify your account to continue."** 在开头，被截掉了。
      「报错里只剩最没用的那一段」等于没有报错 —— 排查要多绕一整轮（实测绕了一轮）。

    ★ 判据：**先找结构化的 `"message": "..."`**（agy 的错误 JSON 里就有），
      找不到再退回取**头部**。尾部只在栈回溯时有用，而 agy 这条路径不吐栈。
    """
    s = " ".join((stderr or "").split())
    if not s:
        return "(无 stderr)"
    m = re.search(r'"(?:validation_error_)?message"\s*:\s*"([^"]{4,200})"', s)
    if m:
        return m.group(1)
    return s[:180] + ("…" if len(s) > 180 else "")


def _probe_one(label):
    """对**当前登录**的号跑一次真实生成
    -> (ok, 说明, usage dict|None, **实际跑成的账号 email**|None)。

    ⚠️ `label` 只用于可读性，**它不决定跑哪个号** —— 跑的永远是"此刻钥匙串里那个"。
      这正是第 4 个返回值存在的理由：调用方必须拿它核对，而不是假定 `label` 说了算。

    ★★★ 为什么是"起一次 agy"而不是自己拼 HTTP：
      2026-09-13 实测，直接打 `v1internal:streamGenerateContent` 恒 **429
      RESOURCE_EXHAUSTED**，即使该号额度满格、模型 id 取自它自己的
      `fetchAvailableModels`、也带上了 `loadCodeAssist` 回的 `aicode-consumers`。
      ⚠️ **那个 429 极具误导性**：它长得和「额度用光了」一模一样，而真因是我们
      没有复刻 agy 的完整客户端身份。用它做探针会把"我们拼错了"报成"你的号没额度了"。
      所以探针走 **agy 自己**（`agy -p … --output-format json`）——
      它顺带给出**精确到 token 的用量**，比 codex 那边只能拿到整数百分比还清楚。

    ★ 代价：一次约 30s、约 15k token（实测）。这是**花 agy 自己额度**的动作。
    """
    real = Path(os.environ.get("AGY_REAL", str(Path.home() / ".local" / "bin" / "agy")))
    if not real.exists():
        return False, "找不到 agy（%s）" % real, None, None
    # ★ 记下启动时刻 —— 事后靠它在 agy 自己的日志里找到**这一次**运行，反查真实身份。
    started_at = time.time()
    try:
        r = subprocess.run([str(real), "-p", PROBE_ASK, "--output-format", "json"],
                           capture_output=True, text=True, timeout=PROBE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return False, "超时（%ds）" % PROBE_TIMEOUT, None, None
    if r.returncode != 0:
        return False, "agy 退出码 %d：%s" % (r.returncode, _err_gist(r.stderr)), None, \
               _run_identity(started_at)
    try:
        d = json.loads((r.stdout or "").strip())
    except ValueError:
        return False, "输出不是 JSON（前 120 字：%s）" % (r.stdout or "")[:120], None, \
               _run_identity(started_at)
    ans = (d.get("response") or "").strip()
    if d.get("status") != "SUCCESS" or not ans:
        # ★ 空回答判失败 —— 「受理了」不等于「干成了」。
        return False, "没吐出字（status=%s）" % d.get("status"), d.get("usage"), \
               _run_identity(started_at)
    # 答非所问只标 ⚠️ 不算失败：模型换个措辞不代表账号有问题（同 codex 探针）。
    note = "答「%s」" % ans[:24] + ("" if ans.lower().startswith("ok") else " ⚠️ 答非所问")
    # ★ 成功路径**必须**带回真实身份 —— 花掉的 15k token 记在谁头上由它决定。
    return True, note, d.get("usage"), _run_identity(started_at)


#: 探后读 5h 的次数与间隔。云端摘要的入账有没有延迟**没有实测**，所以读到下降就停，最多等 ~10s。
PROBE_AFTER_TRIES = int(os.environ.get("AGY_PROBE_AFTER_TRIES", "3"))
PROBE_AFTER_GAP = float(os.environ.get("AGY_PROBE_AFTER_GAP", "5"))


def _probe_after(sub, a, pool, ok, before):
    """探后免费读 5h，判「窗口启动了没有」→ `{before, after, reset, started}` 或 None（读不到）。

    ★★ 判据是 **5h 剩余真的降了**（`remainingFraction` 带 7 位小数，一次 ~15k token 的探针看得见），
      不是「重置时间变了」：刚启动的窗口 reset ≈ 启动时刻 + 5h，和闲置浮动的「读数时刻 + 5h」
      只差探针那 ~30s，单看一次读数**分不开**（同 `quota_anchors.py` 头部那条天花板）。
    ★ 只有「探针成功 **且** 5h 降了」才 `note_billed`（同 codex：没证到就不下断言 ——
      多声称一次是把一个假倒计时说成真的）。归属不符时 `ok` 已被翻成 False，自然不标。
    """
    last = None
    for i in range(max(1, PROBE_AFTER_TRIES)):
        if i:
            time.sleep(PROBE_AFTER_GAP)
        cred, err = _refresh_one(sub, a, pool)
        if not cred:
            break
        groups, err = P.fetch_quota(cred["token"]["access_token"])
        if err:
            continue
        bid, after, reset = _gemini_5h(groups)
        last = (groups, bid, after, reset)
        if after is not None and after < before:
            break
    if last is None:
        return None
    groups, bid, after, reset = last
    started = after is not None and after < before
    _store_quota(sub, a, groups, "", billed=bid if (ok and started) else None)
    return {"before": round(before * 100, 2), "after": None if after is None else round(after * 100, 2),
            "reset": int(reset) if reset else None, "started": started}


def _q5_text(q5):
    """探针结果行里的 5h 那一段。读不到就**说读不到**，不写 0、也不写「没变」。"""
    if not q5 or q5.get("after") is None:
        return " · 5h 没读到（无法判断窗口是否启动）"
    b, a = q5["before"], q5["after"]
    if q5["started"]:
        at = time.strftime("%H:%M", time.localtime(q5["reset"])) if q5.get("reset") else "?"
        return " · 5h %.1f%% → %.1f%%（Δ%+.1f）· 窗口已启动，%s 重置" % (b, a, a - b, at)
    return " · 5h 仍 %.1f%%（未见下降：这次消耗还没计进 5h，稍后 ↻ 再看）" % a


def cmd_probe(args):
    """计费探针。★★★ **这是 Gemini 档唯一会花钱的动作，花的是 agy 自己的额度。**

    回答 `health` 回答不了的那个问题：**这个号真的还能干活吗** ——
    凭证有效但订阅到期 / 模型权限被撤 / 被限流，只有真发一次请求才测得出来。

    ★★ **非当值号要先切过去**：agy 只在进程启动时读凭证，没有"指定号发一次请求"
      这种东西（这正是 agy 与 codex 的结构性差异）。所以这里是
      **切过去 → 探 → 切回来**，而且切回来放在 `finally` 里 ——
      中途异常也不能把用户留在别的号上。
    """
    want_json = "--json" in args
    pool = P.load()
    accs = _accounts(pool)
    live = _mark_live(pool)
    names = [a for a in args if not a.startswith("-")]
    if "--all" in args:
        subs = list(accs)
    elif names:
        subs = [s for s in (_by_label(pool, n) for n in names) if s]
    else:
        subs = [live] if live in accs else []
    if not subs:
        sys.exit("没指定要探哪个号 —— `agy-rotate probe <label>` 或 `--all`")

    out = []
    try:
        for sub in subs:
            a = accs[sub]
            # ★★ 探前先**免费**读一次这个号的 5h（云端按账号读，不用切号）—— 同 codex 探针的基线 GET。
            #   没有基线就答不了用户真正想问的那句：「探完之后 5h 窗口启动了没有」。
            cred0, _e0 = _refresh_one(sub, a, pool)
            g0 = P.fetch_quota(cred0["token"]["access_token"])[0] if cred0 else None
            _bid, before, _r0 = _gemini_5h(g0)
            if sub != (P.claims(P.read_live()) or {}).get("sub"):
                cred, err = _refresh_one(sub, a, pool)
                if err:
                    out.append((a, False, "切不过去：%s" % err, None, None))
                    continue
                if P.install_live(cred) != "keyring":
                    out.append((a, False, "只写了兜底文件，agy 多半还在用别的号", None, None))
                    continue
            ok, note, usage, ran_as = _probe_one(a.get("label"))

            # ★★★ **归属核对：没证据就不归属**（2026-09-16 补，同 `agy-quota` 那条纪律）。
            #
            #   `_probe_one` 跑的是"此刻钥匙串里那个号"，而钥匙串被 7 个常驻 agy 进程并发写
            #   （本机实测，且它们身份不同）。装进去到 agy 真正读到之间有一个窗口，
            #   期间可能已被别的进程冲掉 ⇒ **实际是 A 在跑，我们却把 ✓ 和 15k token 记给 B**。
            #   本机 `agy.log` 的「钥匙串被别的 agy 进程写回过」已出现 9 次 —— 不是理论风险。
            #
            #   ★ 三态，**刻意不合并**：
            #     · 对得上          → 正常记账；
            #     · **对不上**      → 这一次的结果属于**另一个号**，绝不能记在本号上。
            #                        钱已经花了，所以照实登记成一条失败并点名真身，
            #                        而不是假装没发生过（花了钱却查不到，比记错更糟）。
            #     · 认不出（None）  → 只标注"未证实"，**不翻转 `ok`** ——
            #                        把「这一枪没打中」和「确实跑错了号」合并成同一个值，
            #                        正是本仓反复记的那条错。
            want = (a.get("email") or "").strip()
            if ran_as and want and ran_as != want:
                ok = False
                note = "归属不符：实际跑的是 %s（本次结果属于那个号，不计在本号上）" % ran_as
                usage = None          # ★ 用量也不能记 —— 它不是这个号花的
            q5 = _probe_after(sub, a, pool, ok, before) if before is not None else None
            a["last_probe"] = {"at": int(time.time()), "ok": ok, "note": note,
                               "usage": usage, "q5h": q5,
                               # 证据本身要落盘：事后"到底跑成了谁"只能从这里查。
                               "ran_as": ran_as,
                               "attributed": bool(ran_as and want and ran_as == want),
                               "via": os.environ.get("CODEX_ROTATE_CALLER") or "cli?"}
            out.append((a, ok, note, usage, q5))
    finally:
        # ★★ 把用户放回他原来的号。放在 finally 里：中途炸了也不能把他留在别处。
        if live and live in accs and (P.claims(P.read_live()) or {}).get("sub") != live:
            cred, err = _refresh_one(live, accs[live], pool)
            if not err:
                P.install_live(cred)
        _mark_live(pool)
        with P._lock(P.POOL):
            P.save(pool)

    if want_json:
        print(json.dumps([{"label": a.get("label"), "ok": ok, "note": n, "usage": u, "q5h": q}
                          for a, ok, n, u, q in out], ensure_ascii=False))
        return out
    for a, ok, note, usage, q5 in out:
        tok = ("（%s token）" % format(usage.get("total_tokens", 0), ",")) if usage else ""
        # ★ 探针是花钱的动作，**成败与用量都要留痕** —— 事后"到底探成没有、花了多少"
        #   只能从这里查（codex 那侧为同一件事栽过一次，见 CLAUDE.md §8 的 `last_probe`）。
        _log("probe [%s] %s %s%s%s" % (a.get("label"), "✓" if ok else "✗", note, tok, _q5_text(q5)))
        print("  [%s] %s %s%s%s" % (a.get("label"), "✓" if ok else "✗", note, tok, _q5_text(q5)))
    return out


DAWN_KEY = "dawn_probe"
#: 超过这个秒数的 `running` 视为进程遗骸（`kill -9` 连 `failed` 都写不下）。同 codex 的 `DAWN_STALE_SECS`。
DAWN_STALE_SECS = 1800


def _dawn_sched():
    """与 `codex-rotate` 共用的到点判据（`dawn_sched.py`）。"""
    import importlib.util as _il
    spec = _il.spec_from_file_location("dawn_sched", Path(os.path.realpath(__file__)).parent / "dawn_sched.py")
    m = _il.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def _dawn_targets(pool):
    """定时探针探哪些号：**全部参与轮换**的（用户 2026-10-15 选定），停用轮换 / 凭证失效的跳过。"""
    return [s for s, a in _accounts(pool).items() if not a.get("rotate_off") and not P.is_dead(a)]


def _dawn_save(patch):
    """持池锁、重读再写 —— `cmd_probe` 中途也会存池，拿手里的旧对象写回会把它的结果冲掉。"""
    with P._lock(P.POOL):
        pool = P.load()
        cur = dict(pool.get(DAWN_KEY) or {})
        cur.update(patch)
        pool[DAWN_KEY] = cur
        P.save(pool)


def cmd_dawn_probe(args):
    """每天定时给 agy 池里**参与轮换的号**各跑一次探针，把 5h 窗口启动起来。

    ★★★ **这是 Gemini 档唯一会自动花钱的东西**（每号约 15k token / 30s，花 agy 自己的额度）。
      护栏与 `codex-rotate dawn-probe` 逐条对齐，一条都不能省：
      ① **默认关闭**（`enabled` 缺省假）—— 仓库公开，默认开启的计费定时器会在别人机器上悄悄花钱；
      ② ★★ **先占天再探** —— launchd 每分钟一次与 app 内补跑两条路都调它，占天写在探针**之前**、
         持池锁，否则并发窗口里就是整池双重计费；`--force` 也不放行「另一个进程正在跑」；
      ③ **每次运行都落痕**（成功 / 失败 / 无号可探都写），设置里看得到「上次运行」。
    ★ 时间可选、区间内随机（`dawn_sched.py`，用户 2026-10-15）。
    ★ 探针会**临时切换钥匙串里的登录号**，结束后在 `finally` 里切回（见 `cmd_probe`）。

    用法：dawn-probe [--no-wait] | --force | --enable | --disable | --time HH:MM | --status
    """
    DS = _dawn_sched()
    pool = P.load()
    rec = dict(pool.get(DAWN_KEY) or {})
    today = time.strftime("%Y-%m-%d")
    if "--time" in args:
        i = args.index("--time")
        hhmm = DS.parse_time(args[i + 1] if i + 1 < len(args) else "")
        if not hhmm:
            sys.exit("用法: agy-rotate dawn-probe --time HH:MM（24 小时制）")
        _dawn_save({"time": hhmm})
        print("Gemini 定时探针时间已设为 %s（区间内随机）" % DS.window_text({"time": hhmm}))
        return
    if "--enable" in args or "--disable" in args:
        on = "--enable" in args
        _dawn_save({"enabled": on})
        print("Gemini 定时探针已%s" % ("启用" if on else "停用"))
        return
    if "--status" in args:
        rec.setdefault("enabled", False)
        rec["time"] = DS.parse_time(rec.get("time")) or DS.DEFAULT_TIME
        rec["window"] = DS.window_text(rec)
        rec["due_at"] = int(DS.due_at(rec, "agy"))
        rec["targets_today"] = [_accounts(pool)[s].get("label") or s[:8] for s in _dawn_targets(pool)]
        print(json.dumps(rec, ensure_ascii=False))
        return

    # ★ `--tick` = 定时任务每 60s 那一下：空转（未启用 / 已跑过 / 未到点）**不出声**，
    #   否则日志每分钟多一行、日志页被刷屏。真跑时照常输出。
    say = (lambda *_: None) if "--tick" in args else print
    force = "--force" in args
    if not force and not rec.get("enabled"):
        say("agy dawn-probe 未启用（agy-rotate dawn-probe --enable）")
        return
    if not force and rec.get("date") == today:
        say("agy dawn-probe 今天（%s）已跑过：%s/%s 可用" % (today, rec.get("ok", 0), rec.get("total", 0)))
        return
    if not force:
        left = DS.due_at(rec, "agy") - time.time()
        if left > 0 and ("--no-wait" in args or left > DS.WAIT_SECS):
            say("agy dawn-probe 未到点（%s 内随机，还差 %ds）" % (DS.window_text(rec), int(left)))
            return
        if left > 0:
            time.sleep(left)

    targets = _dawn_targets(pool)
    claimed = {"n": 0, "state": None, "age": 0}
    # ★★ 先占天，再探。持池锁读-改-写，所以占坑是原子的（同 codex `_mutate_state(_claim)`）。
    with P._lock(P.POOL):
        cur_pool = P.load()
        cur = dict(cur_pool.get(DAWN_KEY) or {})
        if cur.get("date") == today:
            claimed.update(n=1, state=cur.get("state"), age=int(time.time()) - int(cur.get("at") or 0))
        else:
            cur.update({"date": today, "at": int(time.time()), "state": "running",
                        "ok": None, "total": len(targets), "started": None, "note": ""})
            cur_pool[DAWN_KEY] = cur
            P.save(cur_pool)
    if claimed["n"]:
        if claimed["state"] == "running" and claimed["age"] < DAWN_STALE_SECS:
            print("agy dawn-probe 正在另一个进程里运行（%ds 前认领），本次跳过 —— "
                  "`--force` 也不放行，并发会让整池双重计费。" % claimed["age"])
            return
        if not force:
            say("agy dawn-probe 今天（%s）已被认领，本次跳过（防双重计费）。确实要重跑用 --force" % today)
            return

    if not targets:
        # ★ 没号可探是**事实**不是故障 —— 照样落痕，否则明天分不出「跑了没号」和「压根没跑」。
        _dawn_save({"date": today, "at": int(time.time()), "state": "done", "ok": 0, "total": 0,
                    "started": 0, "note": "池里没有参与轮换的号"})
        print("没有参与轮换的 agy 号可探")
        return
    labels = [_accounts(pool)[s].get("label") or s for s in targets]
    print("Gemini 定时探针 · %d 个号：%s" % (len(targets), " ".join(labels)))
    try:
        os.environ["CODEX_ROTATE_CALLER"] = "dawn"      # ★ 这一路的计费必须认得出来
        # ★ 传 sub 不传 label：`_by_label` 先认 sub，label 撞名/叫 `--all` 都不会扩成全池。
        out = cmd_probe(list(targets)) or []
    except BaseException as e:
        # ★ 释放成 failed 而不是抹掉：「今天跑过但崩了」可能已经花过钱，抹掉会让重跑二次计费。
        _dawn_save({"date": today, "at": int(time.time()), "state": "failed",
                    "note": ("%s: %s" % (type(e).__name__, e))[:200]})
        raise
    ok_n = sum(1 for r in out if r[1])
    started = sum(1 for r in out if r[4] and r[4].get("started"))
    _dawn_save({"date": today, "at": int(time.time()), "state": "done",
                "ok": ok_n, "total": len(out), "started": started, "note": ""})
    _log("dawn [%d/%d 可用 · 5h 启动 %d]" % (ok_n, len(out), started))


def cmd_rotate(args):
    """按号开关自动轮换。`agy-rotate rotate <label> --on|--off`

    ★★ 真源是池里的 `rotate_off`，**存反向命名**：缺省必须等于「参与轮换」——
      存量号与 `login` 收编的新号都没有这个键，正向命名要写迁移，
      漏迁移的号会**静默退出轮换池**（症状：自动切号只在那两三个号里转，零报错）。
      恢复时**删键**不是写 `False`，否则"缺省"有两种表示。
      与 codex 的 `rotate_off` 一字不差的同一条设计。
    """
    if len(args) < 2 or args[1] not in ("--on", "--off"):
        sys.exit("usage: agy-rotate rotate <label> --on|--off")
    pool = P.load()
    sub = _by_label(pool, args[0])
    if not sub:
        sys.exit("池里没有 '%s'" % args[0])
    accs = _accounts(pool)
    on = args[1] == "--on"
    if not on:
        # ★ 拒绝关掉最后一个：全关 = 自动切号无号可挑。
        live_n = sum(1 for s, a in accs.items() if not a.get("rotate_off") and s != sub)
        if live_n == 0:
            sys.exit("✗ 这是最后一个还参与轮换的号 —— 全关掉的话自动切号就没号可挑了")
    if on:
        accs[sub].pop("rotate_off", None)
    else:
        accs[sub]["rotate_off"] = True
    with P._lock(P.POOL):
        P.save(pool)
    print("[%s] 自动轮换已%s" % (accs[sub].get("label"), "开启" if on else "关闭"))


def cmd_autoswitch(args):
    """全局自动切号开关。`agy-rotate auto-switch [--on|--off]`

    ★★★ **这条能做，我此前说"做不了"是错的。** 当时的理由是「自动选号发生在
      `bin/agy` 拉起进程之前」—— 那句话本身没错，但结论错了：wrapper 调的是
      `agy-rotate auto`，而它**读池**。所以一个持久化到池里的开关完全控制得住它。
      真源放池里（不放 localStorage）的理由与 codex 的 `dawn_probe` 一致：
      wrapper 在 app 没开时也要读它，两个真源迟早分叉成
      「界面说关着、wrapper 照切」。
    """
    pool = P.load()
    if "--on" in args or "--off" in args:
        off = "--off" in args
        if off:
            pool["auto_off"] = True
        else:
            pool.pop("auto_off", None)      # 删键，不写 False —— 缺省只能有一种表示
        with P._lock(P.POOL):
            P.save(pool)
    on = not pool.get("auto_off")
    if "--json" in args:
        print(json.dumps({"enabled": on}))
    else:
        print("自动切号：%s" % ("开" if on else "关"))


def cmd_live(args):
    """**现在**到底是谁登录着 —— 只读钥匙串，不联网、不改任何状态。

    ★★★ 存在理由：`live_seen` 是**我们上次写进去时看到的值**，而钥匙串是一个
      **被多个长期存活的 agy 进程并发写**的单槽。实测 2026-09-13：
      17:58 我们装进 B，18:23:17 一个身份为 A 的常驻 agy 在它自己的 access token
      到期（18:23:16）时刷新并把整份凭证写回钥匙串 —— B 被冲掉，而 `live_seen`
      毫不知情，界面继续理直气壮地显示 B。用户看到的就是「界面说 B、agy 里是 A」。

    所以 UI 的「当前」徽章必须由**这条现读**驱动，`live_seen` 降级成诊断字段。
    两个事实都给出来，分歧就看得见，而不是被抹平成一个好看的谎。
    """
    pool = P.load()
    cl = P.claims(P.read_live()) or {}
    sub = cl.get("sub")
    seen = pool.get("live_seen")
    if "--json" in args:
        print(json.dumps({"sub": sub, "email": cl.get("email"),
                          "live_seen": seen, "drifted": bool(sub and seen and sub != seen)},
                         ensure_ascii=False))
        return
    label = _accounts(pool).get(sub, {}).get("label") if sub else None
    print("当前登录：%s" % (label or cl.get("email") or sub or "（读不到）"))
    if sub and seen and sub != seen:
        # ★ 不许静默吞掉分歧：它是"有别的 agy 进程把槽抢回去了"的唯一可见证据。
        print("  ⚠️ 与我们上次装进去的 [%s] 不一致 —— 多半是某个**仍在跑**的 agy "
              "在它自己 token 到期时把凭证写回了钥匙串。"
              % (_accounts(pool).get(seen, {}).get("label") or seen[:8]))


CMDS = {"login": cmd_login, "list": cmd_list, "quota": cmd_quota, "switch": cmd_switch,
        "pick": cmd_pick, "auto": cmd_auto, "rename": cmd_rename, "remove": cmd_remove,
        "live": cmd_live, "health": cmd_health, "probe": cmd_probe, "dawn-probe": cmd_dawn_probe,
        "rotate": cmd_rotate, "auto-switch": cmd_autoswitch,
        "next": cmd_next, "pin": cmd_pin, "borrow": cmd_borrow}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    fn = CMDS.get(argv[0])
    if not fn:
        sys.exit("未知命令 '%s' —— 可用: %s" % (argv[0], " ".join(sorted(CMDS))))
    fn(argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
